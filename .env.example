# Copy to .env for local development.
DATABASE_URL=postgres://hyrabostad:hyrabostad@localhost:5433/hyrabostad

# Public origin, used for absolute URLs in sitemaps, emails and the crawler User-Agent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Key for API keys stored on sources (AES-256-GCM). Optional: the auth secret is used when unset.
SOURCE_SECRET_KEY=

# Email. Leave RESEND_API_KEY empty to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Hyrabostad <no-reply@hyrabostad.se>"

# Uploaded images for manually published listings.
# STORAGE_DRIVER=disk keeps them on local disk (development, or a mounted volume);
# STORAGE_DRIVER=s3 uses an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# Either way they are served through /api/uploads, so the bucket stays private.
STORAGE_DRIVER=disk
UPLOAD_DIR=./storage/uploads
S3_BUCKET=
# R2 and MinIO need the endpoint; a real S3 bucket needs the region instead.
S3_ENDPOINT=
S3_REGION=
# Leave the keys empty to use the instance role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Map tiles (MapLibre style URL). Default: OpenFreeMap (free, no key).
# Alternatives: Protomaps self-hosted, or MapTiler with a key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Rate limiting is always on in production; set RATE_LIMIT=on to test it locally.
RATE_LIMIT=

# Crawler
CRAWLER_USER_AGENT="Hyrabostad/1.0 (+http://localhost:3000/sv/om-insamling)"

# Company registry check (Bolagsverket "värdefulla datamängder", free; register at bolagsverket.se).
# Leave empty and the approval queue shows "verify manually".
BOLAGSVERKET_API_URL=
BOLAGSVERKET_TOKEN_URL=
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_API_KEY=

# Number of trusted proxies in front of the app (CDN, load balancer). Decides which
# X-Forwarded-For entry is the client for rate limiting. Default 1.
TRUSTED_PROXY_HOPS=

# Error monitoring. Leave SENTRY_DSN empty and errors are only logged.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Seconds that public search queries stay memoized in the web process (default 60; 0 disables).
CACHE_TTL_SECONDS=

# Development only: let the crawler and connection test reach localhost and private
# addresses (the fixture feed server). Ignored in production.
ALLOW_PRIVATE_FETCH=
