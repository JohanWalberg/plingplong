{
  "name": "hyrabostad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm db:reset && playwright test",
    "test:e2e:only": "playwright test",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "staff:add": "tsx --env-file-if-exists=.env scripts/create-staff.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "i18n:check": "tsx scripts/check-messages.ts",
    "start:all": "bash scripts/start.sh",
    "db:down": "docker compose down",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:reference": "tsx --env-file-if-exists=.env src/db/reference.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@sentry/node": "^10.73.0",
    "better-auth": "^1.7.2",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "maplibre-gl": "^6.7.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "pg-boss": "^12.30.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.4",
    "supercluster": "^9.1.0",
    "undici": "^8.10.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
